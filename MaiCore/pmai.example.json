{
  "version": 1,
  "defaultAgent": "hello",
  "plugins": [
    {
      "path": "./plugins/example.dylib",
      "enabled": false,
      "required": false
    }
  ],
  "providers": [
    {
      "id": "hello",
      "kind": "hello"
    },
    {
      "id": "openai",
      "kind": "openAICompatible",
      "displayName": "OpenAI",
      "baseURL": "https://api.openai.com/v1",
      "apiKeyEnvironment": "OPENAI_API_KEY"
    },
    {
      "id": "local",
      "kind": "openAICompatible",
      "displayName": "Local OpenAI-compatible server",
      "baseURL": "http://127.0.0.1:8080/v1"
    }
  ],
  "toolSources": [
    {
      "id": "standard-tools",
      "kind": "standard-tools",
      "options": {
        "filesRoot": ".",
        "filesWriteEnabled": true,
        "webSearchProvider": "exa",
        "weatherLocation": "",
        "mastodonInstance": "mastodon.social",
        "mastodonAPIKeyEnvironment": "MASTODON_API_KEY",
        "mastodonWriteEnabled": false
      }
    },
    {
      "id": "example-tools",
      "kind": "example",
      "enabled": false
    }
  ],
  "ocrProviders": [
    {
      "id": "vision",
      "kind": "vision"
    }
  ],
  "mcpServers": [
    {
      "id": "remote",
      "kind": "streamable-http",
      "enabled": false,
      "displayName": "Example MCP",
      "url": "https://your-mcp.example/mcp",
      "bearerTokenEnvironment": "MCP_API_KEY",
      "toolNamePrefix": "remote",
      "defaultApproval": "confirm"
    }
  ],
  "agents": [
    {
      "id": "hello",
      "displayName": "Offline hello",
      "instructions": "Exercise the offline MaiCore provider.",
      "provider": "hello",
      "model": ""
    },
    {
      "id": "main",
      "displayName": "Main agent",
      "instructions": "You are a helpful assistant. Use tools when needed.",
      "provider": "openai",
      "model": "your-model",
      "toolNames": [
        "calculator",
        "current_time",
        "echo",
        "files_delete",
        "files_find",
        "files_grep",
        "files_list",
        "files_read",
        "files_read_document",
        "files_rename",
        "files_write",
        "github_ci_log",
        "github_ci_status",
        "github_commit",
        "github_commits",
        "github_issue",
        "github_issues",
        "github_list_files",
        "github_list_prs",
        "github_pr",
        "github_pr_diff",
        "github_read_file",
        "github_releases",
        "mastodon",
        "read_text_file",
        "weather",
        "web_fetch",
        "web_search"
      ],
      "toolGroupNames": [
        "calculator",
        "datetime",
        "echo",
        "files",
        "github",
        "mastodon",
        "weather",
        "web"
      ],
      "subagentNames": [
        "researcher"
      ],
      "useToolProxy": true,
      "limits": {
        "maxModelTurns": 12,
        "maxToolCalls": 20,
        "maxSubagents": 4,
        "maxSubagentDepth": 2
      }
    },
    {
      "id": "researcher",
      "displayName": "Researcher",
      "instructions": "Investigate the delegated task and return a concise result.",
      "provider": "openai",
      "model": "your-model",
      "toolNames": [
        "current_time"
      ],
      "toolGroupNames": [
        "datetime"
      ]
    }
  ],
  "approvals": {
    "confirm": "ask",
    "dangerous": "ask"
  }
}
