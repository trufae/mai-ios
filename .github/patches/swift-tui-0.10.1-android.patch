diff --git a/Vendor/UnixSignals/Sources/UnixSignals/CrashSignalHandler.swift b/Vendor/UnixSignals/Sources/UnixSignals/CrashSignalHandler.swift
index 19206c2..d639d2d 100644
--- a/Vendor/UnixSignals/Sources/UnixSignals/CrashSignalHandler.swift
+++ b/Vendor/UnixSignals/Sources/UnixSignals/CrashSignalHandler.swift
@@ -211,9 +211,12 @@ extension CrashSignalHandler {
           // __sigaction_u is a C union; assigning into one of its members has
           // no static type-safety guarantee, so this read is genuinely unsafe.
           unsafe action.__sigaction_u.__sa_handler = crashSignalHandler
-        #elseif canImport(Glibc) || canImport(Musl) || canImport(Android)
-          // The Glibc/Musl/Android shape is a typed struct, no `unsafe` needed.
+        #elseif canImport(Glibc) || canImport(Musl)
+          // The Glibc/Musl shape is a typed struct, no `unsafe` needed.
           action.__sigaction_handler = .init(sa_handler: crashSignalHandler)
+        #elseif canImport(Android)
+          // Bionic exposes the anonymous sigaction union member directly.
+          action.sa_handler = crashSignalHandler
         #endif
         // SA_RESETHAND/SA_ONSTACK Swift-import types differ across platforms
         // (Glibc surfaces SA_RESETHAND as UInt32 because 0x80000000 overflows
@@ -285,7 +288,11 @@ extension CrashSignalHandler {
 
       var stack = unsafe stack_t()
       unsafe stack.ss_sp = unsafe buffer
-      unsafe stack.ss_size = crashAltStackSize
+      #if canImport(Android)
+        unsafe stack.ss_size = UInt(crashAltStackSize)
+      #else
+        unsafe stack.ss_size = crashAltStackSize
+      #endif
       unsafe stack.ss_flags = 0
       unsafe sigaltstack(&stack, nil)
     }
@@ -298,7 +305,11 @@ extension CrashSignalHandler {
 
       var stack = unsafe stack_t()
       unsafe stack.ss_flags = Int32(SS_DISABLE)
-      unsafe stack.ss_size = crashAltStackSize
+      #if canImport(Android)
+        unsafe stack.ss_size = UInt(crashAltStackSize)
+      #else
+        unsafe stack.ss_size = crashAltStackSize
+      #endif
       unsafe stack.ss_sp = unsafe buffer
       unsafe sigaltstack(&stack, nil)
 
